---
interface Props {
  locale?: string;
}
const { locale = "en" } = Astro.props;
const zh = locale !== "en";
const tw = locale === "zh-tw";
const pick = (en: string, cn: string, traditional = cn) =>
  zh ? (tw ? traditional : cn) : en;
const origin = "https://wangrunlin.github.io";
const canonical = `${origin}${zh ? `/${locale}/` : "/"}`;
const title = pick(
  "Leo Wang · Open Source",
  "Leo Wang · 开源主页",
  "Leo Wang · 開源主頁",
);
const description = pick(
  "Open-source projects, developer tools, and contributions by Leo Wang. Explore prompts, web starters, and small useful tools.",
  "Leo Wang 的开源项目、开发工具与代码贡献：提示词、Web 模板和实用小工具。",
  "Leo Wang 的開源專案、開發工具與程式碼貢獻：提示詞、Web 範本和實用小工具。",
);
const projects = [
  {
    name: "Awesome GPT Image 2.5 Prompts",
    repo: "awesome-gpt-image-2-5-prompts",
    icon: "✳",
    type: pick("Creative resource", "创作资源", "創作資源"),
    text: pick(
      "Curated prompts, visual examples, and source-backed creative workflows.",
      "精选提示词、视觉示例与可追溯来源的创作流程。",
      "精選提示詞、視覺範例與可追溯來源的創作流程。",
    ),
    tags: ["Prompts", "Images", "MIT"],
  },
  {
    name: "SEO Next.js Starter",
    repo: "seo-nextjs-starter",
    icon: "</>",
    type: pick("Web starter", "Web 启动模板", "Web 啟動範本"),
    text: pick(
      "A starting point for building SEO-focused Next.js applications.",
      "面向 SEO 的 Next.js 应用启动模板。",
      "面向 SEO 的 Next.js 應用啟動範本。",
    ),
    tags: ["Next.js", "TypeScript", "MIT"],
  },
  {
    name: "Copy Title Extension",
    repo: "copy-title-extension",
    icon: "↗",
    type: pick("Browser utility", "浏览器工具", "瀏覽器工具"),
    text: pick(
      "A browser extension for copying page titles.",
      "用于复制网页标题的浏览器扩展。",
      "用於複製網頁標題的瀏覽器擴充功能。",
    ),
    tags: ["Browser", "Productivity"],
  },
  {
    name: "Android Copy Link",
    repo: "android-copy-link",
    icon: "⌘",
    type: pick("Mobile utility", "移动端工具", "行動端工具"),
    text: pick(
      "A small Android app for copying links.",
      "用于复制链接的 Android 小工具。",
      "用於複製連結的 Android 小工具。",
    ),
    tags: ["Android", "Links"],
  },
];
const products = [
  {
    name: "H3Run",
    url: "https://h3run.com",
    kind: pick("AI video", "AI 视频", "AI 影片"),
  },
  {
    name: "H3MaxLive",
    url: "https://h3maxlive.com",
    kind: pick("Interactive video", "互动视频", "互動影片"),
  },
  {
    name: "Image 2.5",
    url: "https://image-2-5.com",
    kind: pick("AI images", "AI 图片", "AI 圖片"),
  },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  url: canonical,
  description,
  mainEntity: {
    "@type": "Person",
    name: "Leo Wang",
    url: "https://wangrunlin.com",
    sameAs: ["https://github.com/wangrunlin", "https://alin.run"],
  },
};
---

<!doctype html>
<html lang={locale === "zh-cn" ? "zh-CN" : tw ? "zh-TW" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${origin}/`} />
    <link rel="alternate" hreflang="zh-CN" href={`${origin}/zh-cn/`} />
    <link rel="alternate" hreflang="zh-TW" href={`${origin}/zh-tw/`} />
    <link rel="alternate" hreflang="x-default" href={`${origin}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${origin}/og-open-source.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wangrunlin_" />
    <meta name="theme-color" content="#101018" />
    <link rel="icon" href="/favicon.png" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    ></script>
  </head>
  <body>
    <a class="skip" href="#projects">
      {pick("Skip to projects", "跳到项目", "跳到專案")}
    </a>
    <div class="page">
      <header>
        <a class="brand" href={zh ? `/${locale}/` : "/"}>
          <span aria-hidden="true">〈/〉</span> Leo Wang
        </a>
        <nav aria-label={pick("Language", "语言", "語言")}>
          <a href="/" aria-current={!zh ? "page" : undefined}>
            EN
          </a>
          <a
            href="/zh-cn/"
            aria-current={locale === "zh-cn" ? "page" : undefined}
          >
            简
          </a>
          <a href="/zh-tw/" aria-current={tw ? "page" : undefined}>
            繁
          </a>
        </nav>
      </header>
      <main>
        <section class="hero">
          <div>
            <p class="eyebrow">GITHUB / WANGRUNLIN</p>
            <h1>
              {pick("Small tools.", "实用工具。", "實用工具。")}
              <br />
              <span>{pick("Shared openly.", "开放分享。", "開放分享。")}</span>
            </h1>
            <p class="intro">
              {pick(
                "I’m Leo, an independent developer. This is a home for my open-source projects, experiments, and contributions.",
                "我是 Leo，一名独立开发者。这里集中展示我的开源项目、实验与代码贡献。",
                "我是 Leo，一名獨立開發者。這裡集中展示我的開源專案、實驗與程式碼貢獻。",
              )}
            </p>
            <div class="actions">
              <a
                class="button"
                href="https://github.com/wangrunlin?tab=repositories"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path d="m8 5-7 7 7 7m8-14 7 7-7 7m-2-16-4 20" />
                </svg>
                {pick("Browse repositories", "浏览开源仓库", "瀏覽開源儲存庫")}
              </a>
              <a href="https://github.com/wangrunlin?tab=overview#contributions">
                {pick("View contributions", "查看代码贡献", "查看程式碼貢獻")} ↗
              </a>
            </div>
          </div>
          <aside>
            <img
              src="/assets/portrait.jpg"
              width="480"
              height="620"
              alt="Leo Wang"
            />
            <div>
              <span>
                {pick("Independent developer", "独立开发者", "獨立開發者")}
              </span>
              <strong>@wangrunlin</strong>
            </div>
          </aside>
        </section>
        <section id="projects">
          <div class="section-heading">
            <div>
              <p class="eyebrow">01 / OPEN SOURCE</p>
              <h2>
                {pick("Selected projects", "精选开源项目", "精選開源專案")}
              </h2>
            </div>
            <a href="https://github.com/wangrunlin?tab=repositories">
              {pick("All repositories", "全部仓库", "全部儲存庫")} ↗
            </a>
          </div>
          <div class="projects">
            {projects.map((p) => (
              <a
                class="project"
                href={`https://github.com/wangrunlin/${p.repo}`}
              >
                <div class="project-top">
                  <span class="project-icon" aria-hidden="true">
                    {p.icon}
                  </span>
                  <span>{p.type}</span>
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
                <h3>{p.name}</h3>
                <p>{p.text}</p>
                <div class="tags">
                  {p.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </section>
        <section class="products">
          <div>
            <p class="eyebrow">02 / ALSO BUILDING</p>
            <h2>
              {pick(
                "Beyond the repositories",
                "也在做这些产品",
                "也在做這些產品",
              )}
            </h2>
          </div>
          <div class="product-links">
            {products.map((p) => (
              <a href={p.url}>
                <span>
                  <strong>{p.name}</strong>
                  <small>{p.kind}</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
        <section class="elsewhere">
          <h2>{pick("More about me", "了解更多", "瞭解更多")}</h2>
          <div>
            <a href="https://wangrunlin.com">
              <strong>wangrunlin.com ↗</strong>
              <span>
                {pick(
                  "Writing, work & life",
                  "文章、作品与生活",
                  "文章、作品與生活",
                )}
              </span>
            </a>
            <a href="https://alin.run">
              <strong>alin.run ↗</strong>
              <span>
                {pick(
                  "My social card & links",
                  "社交名片与链接",
                  "社交名片與連結",
                )}
              </span>
            </a>
          </div>
        </section>
      </main>
      <footer>
        <span>© {new Date().getFullYear()} Leo Wang</span>
        <a href="https://github.com/wangrunlin/wangrunlin.github.io">
          {pick("Source for this site", "本站源码", "本站原始碼")} ↗
        </a>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: dark;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: #ececf5;
    background: #101018;
    --muted: #a2a2b5;
    --accent: #b7a2ef;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: radial-gradient(ellipse at 90% 0%, #252036 0, transparent 40%);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: #d0bfff;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  p,
  h1,
  h2,
  h3 {
    margin: 0;
  }
  .page {
    max-width: 1120px;
    padding: 0 32px;
    margin: auto;
  }
  .skip {
    position: absolute;
    top: -100px;
    left: 20px;
    background: #101018;
    padding: 12px;
  }
  .skip:focus {
    top: 10px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 0;
    border-bottom: 1px solid #2a2837;
  }
  .brand {
    display: flex;
    gap: 12px;
    align-items: center;
    font-weight: 650;
  }
  .brand span {
    color: var(--accent);
    font-family: monospace;
    font-size: 24px;
  }
  nav {
    display: flex;
    gap: 20px;
    font-size: 13px;
    color: var(--muted);
  }
  nav [aria-current="page"] {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 8px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 72px;
    align-items: center;
    padding: 76px 0 88px;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    font-family: monospace;
    color: var(--accent);
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2.5rem, 5.3vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.055em;
    font-weight: 650;
  }
  h1 span {
    color: var(--accent);
  }
  .intro {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.8;
    max-width: 470px;
    margin-top: 26px;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
    font-size: 13px;
  }
  .button {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 17px;
    border-radius: 10px;
    background: #b7a2ef;
    color: #171120;
    font-weight: 650;
  }
  .button:hover {
    background: #d0bfff;
    color: #171120;
  }
  .hero aside {
    position: relative;
    align-self: stretch;
    max-height: 410px;
    border: 1px solid #3b3448;
    border-radius: 24px;
    overflow: hidden;
  }
  .hero img {
    display: block;
    object-fit: cover;
    object-position: center 25%;
    width: 100%;
    height: 100%;
    filter: saturate(0.8);
  }
  .hero aside div {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px 24px 24px;
    background: linear-gradient(transparent, #101018);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hero aside span {
    font-size: 12px;
    color: #d1c9e4;
  }
  .hero aside strong {
    font-size: 18px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 24px;
  }
  h2 {
    font-size: 28px;
    letter-spacing: -0.025em;
  }
  .section-heading a {
    font-size: 13px;
    color: var(--muted);
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .project {
    padding: 28px;
    border: 1px solid #32303e;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    background: #181720;
    transition: border-color 0.15s;
  }
  .project:hover {
    border-color: #8a75b6;
    color: inherit;
  }
  .project-top {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 11px;
  }
  .project-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-content: center;
    border-radius: 10px;
    background: #2b243c;
    color: #c7b3f2;
    font: 18px monospace;
  }
  .arrow {
    margin-left: auto;
    font-size: 20px;
  }
  h3 {
    font-size: 21px;
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin: 24px 0 12px;
  }
  .project p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
    max-width: 390px;
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 24px;
  }
  .tags span {
    border: 1px solid #383342;
    border-radius: 5px;
    padding: 4px 7px;
    font: 10px monospace;
    color: #c3b7d9;
  }
  .products {
    margin: 72px 0;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 45px;
    padding: 36px 0;
    border-block: 1px solid #302c3c;
  }
  .product-links {
    display: grid;
    gap: 0;
  }
  .product-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid #292633;
  }
  .product-links a:first-child {
    padding-top: 0;
  }
  .product-links a:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .product-links strong {
    display: block;
    font-size: 17px;
  }
  .product-links small {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    color: var(--muted);
  }
  .elsewhere h2 {
    font-size: 20px;
    margin-bottom: 24px;
  }
  .elsewhere > div {
    display: flex;
    gap: 64px;
  }
  .elsewhere a {
    display: grid;
    gap: 8px;
  }
  .elsewhere strong {
    font-size: 16px;
    font-weight: 500;
  }
  .elsewhere span {
    font-size: 12px;
    color: var(--muted);
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 64px;
    padding: 28px 0;
    border-top: 1px solid #302c3c;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .page {
      padding: 0 20px;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 0;
    }
    .hero aside {
      height: 260px;
    }
    .hero img {
      object-position: center 28%;
    }
    .projects {
      grid-template-columns: 1fr;
    }
    .section-heading {
      align-items: start;
    }
    .section-heading a {
      white-space: nowrap;
      padding-top: 30px;
    }
    h2 {
      font-size: 23px;
    }
    .products {
      grid-template-columns: 1fr;
      gap: 28px;
      margin: 44px 0;
    }
    .elsewhere > div {
      gap: 30px;
      flex-wrap: wrap;
    }
    .project {
      padding: 24px;
    }
    .intro {
      font-size: 16px;
    }
    footer {
      margin-top: 44px;
    }
    .actions {
      gap: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
